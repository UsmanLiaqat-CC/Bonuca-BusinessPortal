# Bonuca Business Portal — environment configuration.
# Only VITE_-prefixed values reach the browser bundle. Never put secrets here.

# Data source. Only "dev" exists today: an in-browser development backend
# (localStorage). A production adapter must be written against the real Bonuca API
# contract once it exists — no endpoints are assumed by this frontend.
VITE_DATA_SOURCE=dev

# Shows the developer tools panel (simulate Super Admin override, trial expiry, seed accounts).
VITE_ENABLE_DEV_TOOLS=true

# Public base URL that printed join/campaign QR codes point to (customer-facing
# join flow, out of scope for this portal). When unset, QR codes are generated with
# a non-routable development URL and labelled as such.
VITE_JOIN_BASE_URL=

# Public download link(s) for the Bonuca mobile app (Landing "Download App").
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
